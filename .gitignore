# ============================================
# Git 忽略文件配置
# ============================================

# 环境变量文件（包含敏感信息）
.env
.env.local
.env.*.local

# 数据库备份文件（可能包含敏感数据）
database/*backup*.sql
database/*.sql.bak

# 备份文件
*.bak
*.backup
backup/

# 临时文件
*.tmp
*.temp
*.log
/tmp/

# IDE 配置
.idea/
.vscode/
.trae/
*.swp
*.swo

# 系统文件
.DS_Store
Thumbs.db

# Composer 依赖（如果有）
# vendor/

# Node 依赖（如果有）
node_modules/

# 编译输出（如果有）
# dist/
# build/
